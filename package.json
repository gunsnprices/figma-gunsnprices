{
  "name": "figma-gunsnprices",
  "version": "0.1.0",
  "private": true,
  "description": "Gun & Ammo Data: a Figma and FigJam plugin that fills text layers with real firearm models, calibers, prices and ammo boxes from the GunsNPrices catalog, and normalizes caliber names. Offline.",
  "homepage": "https://gunsnprices.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gunsnprices/figma-gunsnprices.git"
  },
  "bugs": {
    "url": "https://github.com/gunsnprices/figma-gunsnprices/issues"
  },
  "author": "GunsNPrices <app@gunsnprices.com> (https://gunsnprices.com)",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "figma",
    "figma-plugin",
    "figjam",
    "placeholder-data",
    "mock-data",
    "firearms",
    "guns",
    "ammo",
    "caliber",
    "gunsnprices"
  ],
  "scripts": {
    "build": "node build.mjs",
    "build:core": "node build.mjs --core",
    "typecheck": "tsc -p . && tsc -p tsconfig.ui.json",
    "data": "node scripts/build-data.mjs",
    "assets": "python3 scripts/render_assets.py",
    "test": "npm run typecheck && node build.mjs && node build.mjs --core && node --test \"test/*.test.mjs\""
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.142.0",
    "@types/node": "^22.20.0",
    "esbuild": "^0.28.2",
    "gunsnprices": "^0.1.2",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}
